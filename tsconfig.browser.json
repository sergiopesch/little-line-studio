{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src/browser/**/*.ts",
    "tests/types-browser/**/*.ts",
    "src/*.tsx",
    "src/i18n.ts",
    "tests/types-browser/**/*.tsx",
    "src/drawing/**/*.ts",
    "src/lesson-geometry.ts",
    "src/outline-marks.ts",
    "src/crayon-appearance.ts",
    "src/crayon-grain.ts",
    "src/authoring/**/*.ts",
    "src/lesson-model.ts",
    "src/teaching-pack.ts",
    "src/lesson-packs.ts",
    "src/crayon-regions.ts",
    "src/lessons/basic.js",
    "src/lessons/intermediate.js",
    "src/lessons/expert.js",
    "src/sun-teaching-pack.js",
    "src/rainbow-teaching-pack.js",
    "src/balloon-teaching-pack.js",
    "src/cat-pilot.js",
    "src/basic-complete-packs.js",
    "src/intermediate-complete-packs.js",
    "src/expert-complete-packs.js",
    "src/lesson-catalogue.js",
    "src/localization/**/*.ts",
    "src/localized-catalogue.ts",
    "src/locale-registry.ts",
    "src/spanish-lessons.js",
    "src/spanish-spain-lessons.js",
    "src/french-lessons.js",
    "src/german-lessons.js",
    "src/italian-lessons.js",
    "src/dutch-lessons.js",
    "src/german-dynamic.js",
    "src/italian-dynamic.js",
    "src/spanish-spain-dynamic.js",
    "src/dutch-dynamic.js",
    "src/french-dynamic.fr-FR.js"
  ]
}
