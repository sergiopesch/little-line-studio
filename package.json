{
  "name": "trazolino",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-lesson-directory.mjs --check && node scripts/generate-preview-outlines.mjs --check",
    "build": "vite build && node scripts/prepare-build.mjs",
    "preview": "vite preview",
    "test": "node --test --test-isolation=none tests/*.test.js tests/*.test.mjs",
    "update:previews": "node scripts/generate-preview-outlines.mjs --write",
    "update:directory": "node scripts/generate-lesson-directory.mjs --write",
    "update:social-card": "node scripts/render-social-card.mjs",
    "check": "npm run typecheck && npm run build && npm test",
    "test:browser": "playwright test",
    "verify:production": "node scripts/verify-production.mjs",
    "review:localization": "node scripts/localization-review.mjs",
    "test:accessibility": "playwright test accessibility.spec.js",
    "typecheck": "tsc --noEmit",
    "agent": "node scripts/agent-workspace.mjs",
    "verify:engine-parity": "node scripts/verify-engine-parity.mjs"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tldraw/assets": "^5.5.2",
    "@vitejs/plugin-react": "5.0.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tldraw": "^5.5.2",
    "vite": "^6.4.5"
  },
  "description": "Parent-supervised drawing lessons that help children create on paper.",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "typescript": "7.0.2"
  }
}
